# Copy this file to .env.local and fill in the values, then restart the dev server.
# Until these are set, the contact form falls back to opening the visitor's mail app.

# Where contact form messages are delivered.
CONTACT_TO=info@hacktheloop.org

# The mailbox the site sends *from*. Usually the same as SMTP_USER.
CONTACT_FROM=info@hacktheloop.org

# SMTP details from your mail provider.
# Google Workspace: smtp.gmail.com, port 465, and an App Password (not your normal password).
# Zoho: smtp.zoho.eu, port 465.  Fastmail: smtp.fastmail.com, port 465.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@hacktheloop.org
SMTP_PASS=your-app-password-here

# Google Analytics 4 measurement ID, looks like G-XXXXXXXXXX.
# Leave it empty and the site loads no analytics at all. When it is set,
# analytics still only runs for visitors who accept analytics cookies.
NEXT_PUBLIC_GA_ID=
